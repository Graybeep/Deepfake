# Copy to .env for docker-compose. Never commit a filled-in .env.

# --- Postgres ---
DF_PG_DSN=postgresql://deepfake:deepfake@postgres:5432/deepfake

# --- Redis ---
# Persistence is REQUIRED (Tier 1): compose starts redis with AOF everysec.
# In-flight job status lives here; a default in-memory config loses it on restart.
DF_REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally, S3 in deployed envs) ---
DF_S3_ENDPOINT=http://minio:9000
DF_S3_PUBLIC_ENDPOINT=http://localhost:9000
DF_S3_BUCKET=deepfake-ingest
DF_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
DF_S3_FORCE_PATH_STYLE=1

# Presigned upload URL lifetime (seconds)
DF_PRESIGN_TTL_SECONDS=900
# Max upload size accepted by the presigned policy (bytes) -- 2 GiB
DF_MAX_UPLOAD_BYTES=2147483648

# --- Rate limiting (ingress, Tier 1) ---
DF_RATELIMIT_CAPACITY=30
DF_RATELIMIT_REFILL_PER_SEC=0.5

# --- Inference backend ---
# stub  = deterministic placeholder scorer, NOT a detector. Default.
# torch = load real weights from DF_FACE_WEIGHTS / DF_AUDIO_WEIGHTS.
DF_INFERENCE_BACKEND=stub
DF_FACE_WEIGHTS=
DF_AUDIO_WEIGHTS=

# --- Retention ---
# Tier 1: raw media + face crops are TTL-deleted on inference completion.
DF_RAW_TTL_SECONDS=0
# Tier 2: fixed-timer extended retention window for high-band results.
# This is NOT a legal hold -- it auto-expires. See CLAUDE.md.
DF_EXTENDED_RETENTION_DAYS=30

# --- Queue / DLQ (Tier 2) ---
DF_MAX_ATTEMPTS=3
