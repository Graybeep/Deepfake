#!/bin/sh
# Enable once per clone:  git config core.hooksPath .githooks
#
# Two checks, both mechanical, both for things a written rule already lost to:
#   1. no tracked document may claim a test count that is not the real one.
#   2. a schema change must carry the doc regeneration in the SAME commit.
#
# Check 1 covers every document in check_docs_current.DOCUMENTS -- currently
# docs/solution-overview.html and README.md. It was scoped to docs/ alone until
# 2026-08-26, and in that window README.md drifted to 106 against an actual 157
# without anything noticing. The guard for that exact failure was pointed at the
# wrong file.
#
# Neither check can judge whether the prose still describes the system. They only
# catch the counted claims and the schema case, which is what actually drifted.

set -e

python scripts/check_docs_current.py || {
    echo ""
    echo "pre-commit: a tracked document is stale. Fix it or commit with"
    echo "--no-verify if you genuinely mean to leave it that way."
    exit 1
}

# A migration changes what the system stores; the document describes what it
# stores. Those move together or the document is wrong the moment it lands.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q '^migrations/' && ! echo "$staged" | grep -q '^docs/'; then
    echo "pre-commit: this commit changes migrations/ but not docs/."
    echo "Schema changes regenerate the solution document in the same commit"
    echo "(CLAUDE.md). If this migration genuinely changes nothing the document"
    echo "describes, commit with --no-verify."
    exit 1
fi

exit 0
